# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (Neon Serverless Postgres) ---
# Get one at https://neon.tech (free tier is fine).
# When unset, the server runs in IN-MEMORY MODE (no persistence between restarts).
DATABASE_URL=

# --- Session (REQUIRED in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server will refuse to start in NODE_ENV=production without a non-default value here.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Public origin (used for magic-link URLs behind proxies) ---
# If unset, magic links use the request Host header. Set this when running behind
# a reverse proxy or tunnel (e.g. ngrok, Cloudflare) so links point to the right URL.
# Production example (Render + custom domain):
# APP_PUBLIC_ORIGIN=https://chessgm.co

# --- One-off: apply Drizzle schema to production Postgres ---
# From your PC, use the **External** connection string from Render → Postgres → Connections.
# Do not commit real URLs or passwords into git.
#   PowerShell:  $env:DATABASE_URL="postgresql://..."; npm.cmd run db:push:production
#   Then:        Remove-Item Env:DATABASE_URL

# --- Admin pricing endpoint ---
# Required to use PUT /api/admin/pricing or the /admin/pricing page. Send as
# `Authorization: Bearer <ADMIN_API_KEY>` or header `X-Admin-Key: <ADMIN_API_KEY>`.
ADMIN_API_KEY=

# --- Magic-link email (Resend) ---
# https://resend.com — free tier is enough for sign-in links. When unset, the
# magic-link is printed in the server log instead of being emailed (dev mode).
RESEND_API_KEY=
# Defaults to "onboarding@resend.dev" if unset. Set to a verified sender for prod.
# RESEND_FROM=Chess Finder Pro <noreply@yourdomain.com>

# --- Lichess OAuth (PKCE, no client secret) ---
# Lichess does NOT require app registration — just pick a stable client_id
# string (e.g. your domain) and a redirect_uri that matches your deployment.
# Docs: https://lichess.org/api#tag/OAuth
# For local dev with `PORT=5000`:
LICHESS_CLIENT_ID=chess-finder-pro
LICHESS_REDIRECT_URI=http://localhost:5000/api/auth/lichess/callback

# NOTE on Chess.com:
#   Chess.com does NOT offer OAuth or any user-auth API, so "Login with
#   Chess.com" is not supported. The app still imports games from chess.com
#   via the public Published Data API once a user is signed in via email,
#   magic link, or Lichess.

# --- Stripe (subscription billing) ---
# Sign up at https://dashboard.stripe.com.
#  1) Create two recurring Products in the dashboard:
#     - "Chess Finder Pro — Monthly"   $12.99 / month
#     - "Chess Finder Pro — Yearly"    $79.00 / year
#     Copy each price ID (price_…) into the two vars below.
#  2) Copy your API secret key from Developers > API keys (sk_test_… for
#     test mode, sk_live_… for live).
#  3) Add a webhook endpoint under Developers > Webhooks pointing at
#     https://<your-domain>/api/billing/webhook for events:
#       - checkout.session.completed
#       - customer.subscription.created
#       - customer.subscription.updated
#       - customer.subscription.deleted
#       - invoice.payment_succeeded
#       - invoice.payment_failed
#     Copy the signing secret (whsec_…) into STRIPE_WEBHOOK_SECRET.
#  4) Turn on Customer Portal under Settings > Billing > Customer portal
#     with cancellation, invoice history, and plan switching enabled.
# When STRIPE_SECRET_KEY is unset every /api/billing/* endpoint returns
# 503 so the rest of the app still boots in dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_YEARLY_ID=

# --- Google Analytics 4 + Google Ads (client-side, Vite-injected) ---
# These are PUBLIC values — they get baked into the client bundle. Do not
# put any secret here. Leave blank to disable analytics entirely.
#   VITE_GA4_MEASUREMENT_ID         G-XXXXXXXX (analytics.google.com → Admin → Data Streams)
#   VITE_GOOGLE_ADS_ID              AW-XXXXXXXXXX (ads.google.com → Tools → Conversions → Tag setup)
#   VITE_GOOGLE_ADS_CONVERSION_LABEL <label> from the "Purchase" conversion action
# Consent Mode v2: all signals default to "denied" until the visitor opts
# in via the cookie banner. No analytics fire before consent.
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# --- Coach chat / explanations (optional) ---
# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: Azure / proxy / compatible endpoint
# OPENAI_BASE_URL=
# COACH_OPENAI_MODEL=gpt-4.1-mini

# Free Groq (OpenAI-compatible): https://console.groq.com — used when OPENAI_API_KEY is unset
GROQ_API_KEY=
# COACH_GROQ_MODEL=llama-3.1-8b-instant

# Local Ollama — no API key; streaming coach chat tries this when cloud keys are unset.
# After Ollama is installed, run once from project root: npm run setup:ollama
# Install from https://ollama.com then: ollama pull llama3.2
# COACH_DISABLE_LOCAL_OLLAMA=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# COACH_OLLAMA_MODEL=llama3.2
# Offline coach Stockfish pass (speed vs quality)
# COACH_OFFLINE_SF_MS=2800
# Play-page coach: Stockfish-only (lower = faster). Optional second pass from the new position:
# COACH_PLAY_SF_DEPTH=7
# COACH_PLAY_SF_MS=900
# COACH_PLAY_AFTER_MS=390
# COACH_PLAY_AFTER_DEPTH=5

# --- Stockfish (Play vs Computer + analysis) ---
# Full path to the Stockfish executable — strongly recommended on Windows where
# the npm `stockfish` optional dependency often cannot spawn a native binary.
# Example (adjust for your install folder):
# STOCKFISH_PATH=C:\\Stockfish\\stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=

