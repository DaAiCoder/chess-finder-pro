# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (Neon Serverless Postgres) ---
# Get one at https://neon.tech (free tier is fine).
# When unset, the server runs in IN-MEMORY MODE (no persistence between restarts).
DATABASE_URL=

# --- Session (REQUIRED in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server will refuse to start in NODE_ENV=production without a non-default value here.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Dev app login (local / staging only; disabled in production unless DEV_SEED_LOGIN=1) ---
# Created on server boot with a proper scrypt hash. Sign in at /login with username OR email.
# Generate a stronger password: node scripts/gen-password.mjs
DEV_LOGIN_USER=dev
DEV_LOGIN_PASSWORD=dev
DEV_LOGIN_EMAIL=dev@localhost
# DEV_SEED_LOGIN=1
#
# --- Complimentary Pro (internal testers; bypasses Stripe + post-trial lock) ---
# Comma-separated user IDs (numbers) and/or lowercase usernames.
COMPLIMENTARY_USER_IDS=
COMPLIMENTARY_USERNAMES=dev

# --- Training freemium (non-Pro daily puzzle caps; Pro = trial + subscription) ---
# TRAINING_DAILY_LIMIT_ANONYMOUS=5
# TRAINING_DAILY_LIMIT_FREE=15

# --- Public origin (used for magic-link URLs behind proxies) ---
# If unset, magic links use the request Host header. Set this when running behind
# a reverse proxy or tunnel (e.g. ngrok, Cloudflare) so links point to the right URL.
# Production example (Render + custom domain):
# APP_PUBLIC_ORIGIN=https://chessgm.co
#
# Collect endpoint (`POST /api/analytics/collect`) allows Origin/Referer from
# this host and from admin.<apex> derived from it (strip leading www.). Add
# more with comma-separated APP_ANALYTICS_ALLOWED_HOSTS=staging.example.com,https://other.dev

# --- One-off: apply Drizzle schema to production Postgres ---
# From your PC, use the **External** connection string from Render → Postgres → Connections.
# Do not commit real URLs or passwords into git.
#   PowerShell:  $env:DATABASE_URL="postgresql://..."; npm.cmd run db:push:production
# If you see ECONNRESET from home Wi‑Fi, try phone hotspot / another network, or
# run the same command from Render’s shell (paste External URL there), or set:
#   $env:DRIZZLE_KIT_SSL_INSECURE="1"   # relaxes TLS verify for drizzle-kit only
#   Then:        Remove-Item Env:DATABASE_URL
#
# --- Render: auto schema push (no laptop) ---
# In the Web Service dashboard set **Build Command** to:
#   npm ci && node scripts/maybe-drizzle-push.mjs && npm run build
# Render sets RENDER=true and injects DATABASE_URL when Postgres is linked.
# Optional: if drizzle-kit push fails on Postgres but you need the build to ship:
# DRIZZLE_PUSH_LENIENT=1
# Optional: skip `drizzle-kit push` on Render only (analytics DDL still runs first):
# SKIP_DRIZZLE_KIT_PUSH=1

# --- Admin / operator console ---
# Browser login for site analytics + admin pricing (POST /api/operator/login).
# Also used on goadmingo.<apex> before the operator shell. Still supports
# ADMIN_API_KEY as Bearer / X-Admin-Key for scripts.
OPERATOR_DASHBOARD_USER=
OPERATOR_DASHBOARD_PASSWORD=
#
# Same key for scripts / overrides: PUT /api/admin/pricing, GET /api/admin/analytics/*.
ADMIN_API_KEY=
#
# Sign-up alert emails (immediate notify on each new account):
# ADMIN_NOTIFY_EMAILS=you@example.com
#
# Analytics checklist (Render Web Service):
#   DATABASE_URL          — Postgres for page views + analytics_signups
#   ADMIN_API_KEY           — or OPERATOR_DASHBOARD_* for goadmingo login
#   VITE_SITE_APEX=chessgm.co — build-time; enables operator subdomain UI
#   VITE_GA4_MEASUREMENT_ID=G-VHETCRLX0G — build-time; GA4 events
#   VITE_GOOGLE_ADS_ID=AW-931139138       — build-time; Ads tag
#   APP_PUBLIC_ORIGIN=https://chessgm.co  — collect API origin allowlist

# Optional: subdomain operator hints (VITE_SITE_APEX + DNS). Not required for sidebar tools.
# Set on the Web Service so `npm run build` embeds it (Vite). Value = apex only.
# Example: VITE_SITE_APEX=chessgm.co
VITE_SITE_APEX=chessgm.co
#
# Optional: first label(s) before the apex, comma-separated. Default when apex is set:
# goadmingo,admin
# VITE_OPERATOR_SUBDOMAIN_PREFIXES=goadmingo,admin
#
# Alternative to VITE_SITE_APEX: same URL as APP_PUBLIC_ORIGIN (build-time mirror).
# VITE_APP_PUBLIC_ORIGIN=https://chessgm.co

# Comma-separated hostnames that should show the operator SPA shell (sidebar).
# Runtime: injected into index.html. Hostnames only (or full URLs — scheme is stripped).
# Example: ADMIN_PORTAL_HOSTNAMES=goadmingo.chessgm.co
# ADMIN_PORTAL_HOSTNAMES=

# In production, any subdomain of APP_PUBLIC_ORIGIN’s apex (except apex + www)
# is treated as the operator host by default (so goadmingo.* works without the
# list above). Set to off to require an explicit list only:
# ADMIN_PORTAL_USE_REQUEST_HOST=0

# Optional: exact hostname baked at build time (only if you prefer rebuild-based config).
# VITE_ADMIN_PORTAL_HOSTNAME=

# Optional: extra hostnames for POST /api/analytics/collect (in addition to
# APP_PUBLIC_ORIGIN, admin.<apex>, and ADMIN_PORTAL_HOSTNAMES).
# APP_ANALYTICS_ALLOWED_HOSTS=

# Optional ops note for retention jobs (not enforced by the app yet).
# ADMIN_ANALYTICS_RETENTION_DAYS=365

# --- Magic-link email (Resend) ---
# https://resend.com — free tier is enough for sign-in links. When unset, the
# magic-link is printed in the server log instead of being emailed (dev mode).
RESEND_API_KEY=
# Defaults to "onboarding@resend.dev" if unset. Set to a verified sender for prod.
# RESEND_FROM=ChessGM <noreply@mail.chessgm.co>
# Optional display name in email templates (default ChessGM).
# APP_NAME=ChessGM
#
# Admin ops alerts: signups, subscriptions, payment failures (comma-separated).
# ADMIN_NOTIFY_EMAILS=you@example.com,ops@example.com
#
# --- Ops cron (trial emails + admin digest) ---
# OPS_CRON=off                    # disable trial tick + digest
# TRIAL_REMINDER_HOURS=24         # user email + digest: trials ending within N hours
# OPS_TRIAL_TICK_MS=3600000       # check trials every hour
# OPS_DIGEST_INTERVAL_MS=86400000 # daily digest interval (default 24h)
# OPS_DIGEST_SCHEDULE=daily       # or weekly
# OPS_MRR_MONTHLY_USD=12.99
# OPS_MRR_YEARLY_USD=79
#
# --- Ops security thresholds ---
# OPS_LOGIN_SPIKE_THRESHOLD=25
# OPS_SIGNUP_IP_THRESHOLD=5
# OPS_5XX_SPIKE_THRESHOLD=10
# OPS_EMAIL_FAILURE_THRESHOLD=5
#
# --- Resend webhooks (bounces / failures → admin alert) ---
# Dashboard: Webhooks → https://chessgm.co/api/webhooks/resend
# RESEND_WEBHOOK_SECRET=whsec_...

# --- AI support chat widget (Render-style, bottom-right) ---
# Uses OPENAI_API_KEY or GROQ_API_KEY (cloud only; FAQ fallback if unset).
# SUPPORT_CHAT_ENABLED=1          # set 0 or off to hide widget + API
# SUPPORT_DISABLE_LLM=1         # FAQ-only mode (no LLM calls)
# SUPPORT_OPENAI_MODEL=gpt-4.1-mini

# --- Lichess OAuth (PKCE, no client secret) ---
# Lichess does NOT require app registration — just pick a stable client_id
# string (e.g. your domain) and a redirect_uri that matches your deployment.
# Docs: https://lichess.org/api#tag/OAuth
# For local dev with `PORT=5000`:
LICHESS_CLIENT_ID=chess-finder-pro
LICHESS_REDIRECT_URI=http://localhost:5000/api/auth/lichess/callback

# NOTE on Chess.com:
#   Chess.com does NOT offer OAuth or any user-auth API, so "Login with
#   Chess.com" is not supported. The app still imports games from chess.com
#   via the public Published Data API once a user is signed in via email,
#   magic link, or Lichess.

# --- Stripe (subscription billing) ---
# Sign up at https://dashboard.stripe.com.
#  1) Create two recurring Products in the dashboard:
#     - "ChessGM — Monthly"   $12.99 / month
#     - "ChessGM — Yearly"    $79.00 / year
#     Copy each price ID (price_…) into the two vars below.
#  2) Copy your API secret key from Developers > API keys (sk_test_… for
#     test mode, sk_live_… for live).
#  3) Add a webhook endpoint under Developers > Webhooks pointing at
#     https://<your-domain>/api/billing/webhook for events:
#       - checkout.session.completed
#       - customer.subscription.created
#       - customer.subscription.updated
#       - customer.subscription.deleted
#       - invoice.payment_succeeded
#       - invoice.payment_failed
#     Copy the signing secret (whsec_…) into STRIPE_WEBHOOK_SECRET.
#  4) Turn on Customer Portal under Settings > Billing > Customer portal
#     with cancellation, invoice history, and plan switching enabled.
# When STRIPE_SECRET_KEY is unset every /api/billing/* endpoint returns
# 503 so the rest of the app still boots in dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_YEARLY_ID=

# --- Google Analytics 4 + Google Ads (client-side, Vite-injected) ---
# These are PUBLIC — they are baked into the static client bundle at
# `npm run build`. They are NOT read from the Node server at runtime.
#
# Render / production: set these on the **Web Service** env, then deploy so
# Vite rebuilds. Restart-only is not enough. If tags are missing after adding
# vars, use "Clear build cache & deploy" on Render.
#
# GA4 (recommended): analytics.google.com → Admin → Data streams → Web →
#   Measurement ID (ChessGM / chessgm.co stream: G-VHETCRLX0G) → VITE_GA4_MEASUREMENT_ID
# Google Ads conversion: ads.google.com → Tools → Conversions → New action
#   (Website / Purchase, manual tag) → copy Conversion ID + label:
#   VITE_GOOGLE_ADS_ID=AW-931139138
#   VITE_GOOGLE_ADS_CONVERSION_LABEL=i8LQCLjByq8cEMKcgLwD
#   VITE_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=_023CLvByq8cEMKcgLwD
# Full checklist: docs/ads-readiness.md §3
#
# Consent Mode v2: defaults are "denied" until the cookie banner grants
# analytics + ads storage — no hits before consent.
VITE_GA4_MEASUREMENT_ID=G-VHETCRLX0G
VITE_GOOGLE_ADS_ID=AW-931139138
VITE_GOOGLE_ADS_CONVERSION_LABEL=i8LQCLjByq8cEMKcgLwD
VITE_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=_023CLvByq8cEMKcgLwD

# --- Coach chat / explanations (optional) ---
# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: Azure / proxy / compatible endpoint
# OPENAI_BASE_URL=
# COACH_OPENAI_MODEL=gpt-4.1-mini

# Free Groq (OpenAI-compatible): https://console.groq.com — used when OPENAI_API_KEY is unset
GROQ_API_KEY=
# COACH_GROQ_MODEL=llama-3.1-8b-instant

# Local Ollama — no API key; streaming coach chat tries this when cloud keys are unset.
# After Ollama is installed, run once from project root: npm run setup:ollama
# Install from https://ollama.com then: ollama pull llama3.2
# COACH_DISABLE_LOCAL_OLLAMA=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# COACH_OLLAMA_MODEL=llama3.2
# Offline coach Stockfish pass (speed vs quality)
# COACH_OFFLINE_SF_MS=2800
# Play-page coach: Stockfish-only (lower = faster). Optional second pass from the new position:
# COACH_PLAY_SF_DEPTH=7
# COACH_PLAY_SF_MS=900
# COACH_PLAY_AFTER_MS=390
# COACH_PLAY_AFTER_DEPTH=5

# --- Stockfish (Play vs Computer + analysis) ---
# Full path to the Stockfish executable — strongly recommended on Windows where
# the npm `stockfish` optional dependency often cannot spawn a native binary.
# Example (adjust for your install folder):
# STOCKFISH_PATH=C:\\Stockfish\\stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=

