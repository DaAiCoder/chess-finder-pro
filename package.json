{
  "name": "chessfinderpro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "dev:watch": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:push:production": "node scripts/ensure-database-url.mjs && drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "tsc --noEmit",
    "fetch:openings": "tsx scripts/fetch-openings.ts",
    "fetch:pgn-mentor": "tsx scripts/fetch-pgn-mentor.ts",
    "analyze:champion": "tsx --env-file-if-exists=.env scripts/analyze-champion.ts",
    "import:puzzles": "tsx --env-file-if-exists=.env scripts/import-lichess-puzzles.ts",
    "setup:ollama": "node scripts/ensure-ollama.mjs"
  },
  "dependencies": {
